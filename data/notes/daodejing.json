{
  "workId": "daodejing",
  "updatedAt": "2026-08-15T21:49:32.984Z",
  "sentences": {
    "daodejing-01-01": {
      "original": "道可道，非常道。",
      "userNote": "这里面老子应该并不是意指恒常的道不能被解释，毕竟他自己现在也在说道。\n老子更像是在打预防针，道一旦被语言解释（甚至被观测），就只是一种近似，不再能代表道/物理规律本身。",
      "status": "completed",
      "updatedAt": "2026-08-05T19:25:58.421Z"
    },
    "daodejing-01-02": {
      "original": "名可名，非常名。",
      "userNote": "一个事物被怎么称呼或分类，不等于它的自身。",
      "status": "completed",
      "updatedAt": "2026-08-05T19:29:06.354Z"
    },
    "daodejing-01-03": {
      "original": "无名，天地之始。",
      "userNote": "宇宙的起点是0。",
      "status": "reading",
      "updatedAt": "2026-08-05T19:29:51.850Z"
    },
    "daodejing-01-04": {
      "original": "有名，万物之母。",
      "userNote": "0生1，1生万物。",
      "status": "completed",
      "updatedAt": "2026-08-05T19:31:03.486Z"
    },
    "daodejing-01-05": {
      "original": "故常无欲，以观其妙。",
      "userNote": "妙是微妙的意思。\n没有欲望，心就不会乱，就更容易看到事物的隐象和细节。",
      "status": "completed",
      "updatedAt": "2026-08-05T19:34:41.484Z"
    },
    "daodejing-01-06": {
      "original": "常有欲，以观其徼。",
      "userNote": "如果内心有欲望，我们只能关注到事物的表象。",
      "status": "uncertain",
      "updatedAt": "2026-08-05T20:03:24.316Z"
    },
    "daodejing-01-07": {
      "original": "此两者，同出而异名。",
      "userNote": "表象和隐象，并不互斥，只是不同名而已。",
      "status": "completed",
      "updatedAt": "2026-08-05T20:07:24.918Z"
    },
    "daodejing-01-08": {
      "original": "同谓之玄。",
      "userNote": "二者共同成为深奥。",
      "status": "completed",
      "updatedAt": "2026-08-05T20:10:54.399Z"
    },
    "daodejing-01-09": {
      "original": "玄之又玄。",
      "userNote": "深奥里面还有更深奥。",
      "status": "completed",
      "updatedAt": "2026-08-05T20:11:34.701Z"
    },
    "daodejing-01-10": {
      "original": "众妙之门。",
      "userNote": "这是理解所有隐像的入口。",
      "status": "completed",
      "updatedAt": "2026-08-05T20:15:50.976Z"
    },
    "daodejing-03-01": {
      "original": "不尚贤，使民不争。",
      "userNote": "尚贤的就是给人们设立标签，分等级的动作。一个良性的社会应该是不争的社会，人们可以自由地追求自己认为好的东西。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:20:55.871Z"
    },
    "daodejing-03-02": {
      "original": "不贵难得之货，使民不为盗。",
      "userNote": "主动创造稀缺会提高社会的动乱。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:22:52.163Z"
    },
    "daodejing-03-03": {
      "original": "不见可欲，使民心不乱。",
      "userNote": "这句话可作为前两句的解释。\n联想：常有欲，以观其徼。\n引导百姓去追求表象（徼），只会激发他们的欲，甚至民心之乱。\n良性社会的百姓应该是“无欲”的状态，这样人们都在追求世界运作下深层的有意义的东西。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:28:54.518Z"
    },
    "daodejing-03-04": {
      "original": "是以圣人之治，虚其心。",
      "userNote": "务虚，无欲。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:42:59.745Z"
    },
    "daodejing-03-05": {
      "original": "实其腹。",
      "userNote": "物质生活要得到最基本的保障。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:43:44.741Z"
    },
    "daodejing-03-06": {
      "original": "弱其志。",
      "userNote": "在这里我的理解是弱化人们的功利心，并不是让人们志向变小。",
      "status": "completed",
      "updatedAt": "2026-08-13T20:44:55.860Z"
    },
    "daodejing-03-07": {
      "original": "强其骨。",
      "userNote": "身体健康。",
      "status": "completed",
      "updatedAt": "2026-08-13T21:00:28.567Z"
    },
    "daodejing-03-08": {
      "original": "常使民无知无欲。",
      "userNote": "",
      "status": "uncertain",
      "updatedAt": "2026-08-13T21:03:07.281Z"
    },
    "daodejing-03-09": {
      "original": "使夫智者不敢为也。",
      "userNote": "",
      "status": "uncertain",
      "updatedAt": "2026-08-13T21:03:10.535Z"
    },
    "daodejing-03-10": {
      "original": "为无为，则无不治。",
      "userNote": "“为无为”不等于“不为”。\n因为治理本身就是一种为。\n这里指的是，在治理的过程中要把无为这种哲学加入进去，以使秩序自然形成。",
      "status": "completed",
      "updatedAt": "2026-08-13T21:15:35.973Z"
    },
    "daodejing-02-01": {
      "original": "天下皆知美之为美，斯恶已。",
      "userNote": "人们的思维方式很二进制或三进制。人类的天性就会去判断好和坏，和不好不坏。\n所以如果有了美作为好的一面，那二进制的另一端就变成了坏的丑。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:07:15.307Z"
    },
    "daodejing-02-02": {
      "original": "皆知善之为善，斯不善已。",
      "userNote": "善在这里应该是泛化的“好”，这与我对上一句的注释呼应。\n上一句是例子，这一句是泛化总结。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:19:06.498Z"
    },
    "daodejing-02-03": {
      "original": "故有无相生。",
      "userNote": "同出而异名。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:19:32.311Z"
    },
    "daodejing-02-04": {
      "original": "难易相成。",
      "userNote": "同上。\n",
      "status": "completed",
      "updatedAt": "2026-08-15T21:20:15.866Z"
    },
    "daodejing-02-05": {
      "original": "长短相形。",
      "userNote": "同上。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:20:31.757Z"
    },
    "daodejing-02-06": {
      "original": "高下相倾。",
      "userNote": "同上。\n相依。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:20:56.752Z"
    },
    "daodejing-02-07": {
      "original": "音声相和。",
      "userNote": "",
      "status": "uncertain",
      "updatedAt": "2026-08-15T21:21:49.192Z"
    },
    "daodejing-02-08": {
      "original": "前后相随。",
      "userNote": "同上。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:22:09.171Z"
    },
    "daodejing-02-09": {
      "original": "是以圣人处无为之事，行不言之教。",
      "userNote": "这里无为和不言应该是不通过行为或言语来给人们设立标签，分等级。\n圣人不光自己实践无为，还教导别人无为。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:28:01.044Z"
    },
    "daodejing-02-10": {
      "original": "万物作焉而不辞。",
      "userNote": "联系：有名，万物之母。\n这是无为的哲学，虽不推崇标签化万物，但也不会阻拦。",
      "status": "completed",
      "updatedAt": "2026-08-15T21:49:32.984Z"
    }
  }
}
